# Public site URL used for canonical tags, sitemap, robots, and JSON-LD.
# Local / CI builds default to http://127.0.0.1:4477 when this is unset.
# Production (takeoffseo.com) should be:
# NEXT_PUBLIC_SITE_URL=https://takeoffseo.com
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4477

# Optional Formspree form id (the path segment after /f/).
# When unset, enquire forms open a prefilled mailto plus phone/email CTAs.
# NEXT_PUBLIC_FORMSPREE_ID=xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ID=
